# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/mcq

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Admin default (created by seed script)
ADMIN_NAME=Admin Muallim
ADMIN_EMAIL=admin@muallimcarpets.com
ADMIN_PASSWORD=Admin@123

# Manager default password (seed)
MANAGER_PASSWORD=Manager@123

# ------------------------------------------------------------------
# Email (Gmail SMTP) — used for the automatic Daily Data Report PDF.
# 1. Enable 2-Step Verification on your Gmail account.
# 2. Create an "App Password" (Google Account > Security > App passwords).
# 3. Put the 16-char app password in SMTP_PASS below.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
REPORT_RECIPIENT_EMAIL=youremail@example.com

# Cron schedule (5-field) for the daily report. Default: 21:00 every day.
DAILY_REPORT_CRON=0 21 * * *

# ------------------------------------------------------------------
# WhatsApp (Meta Cloud API) - used to send the PDF sale receipt to the
# customer's WhatsApp number after every sale that has a phone number.
# 1. Create a WhatsApp Business Account + app at developers.facebook.com.
# 2. Add the business phone number and copy the Phone Number ID (WHATSAPP_PHONE_ID).
# 3. Generate a permanent access token for the WhatsApp App (WHATSAPP_API_TOKEN).
# ------------------------------------------------------------------
WHATSAPP_API_TOKEN=your_meta_whatsapp_permanent_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
# Destination country code used to convert local numbers (0300... -> 92300...).
WHATSAPP_COUNTRY_CODE=92
# Set to "false" to disable automatic receipt sending.
WHATSAPP_RECEIPTS_ENABLED=true
